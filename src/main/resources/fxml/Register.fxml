<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<!--
  Register.fxml — Placeholder for Phase 5 (Authentication)
  Full implementation will be added in Phase 5.
-->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.lifelink.controller.RegisterController"
      styleClass="login-root"
      alignment="CENTER"
      spacing="20">
    <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>

    <Label text="🩸 LifeLink — Create Account" style="-fx-font-size:24; -fx-font-weight:bold; -fx-text-fill:#f0f4ff;"/>
    <Label text="Full registration form coming in Phase 5." style="-fx-text-fill:#8892b0;"/>
    <Button fx:id="backToLoginBtn" text="← Back to Login"
            styleClass="btn-secondary" onAction="#handleBack"/>
</VBox>
