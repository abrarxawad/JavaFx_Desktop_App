<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.lifelink.controller.HospitalDashboardController"
            styleClass="main-border-pane">

    <!-- ── Sidebar ── -->
    <left>
        <VBox styleClass="sidebar" spacing="0">
            <VBox styleClass="sidebar-brand" spacing="2">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="🏥" styleClass="sidebar-brand-icon"/>
                    <VBox spacing="1">
                        <Label text="LifeLink" styleClass="sidebar-brand-text"/>
                        <Label text="Hospital Portal" styleClass="sidebar-brand-sub"/>
                    </VBox>
                </HBox>
            </VBox>

            <Label text="NAVIGATION" styleClass="sidebar-section-label"/>
            <Button text="📊  Dashboard"         styleClass="sidebar-nav-btn,sidebar-nav-btn-active" maxWidth="Infinity" onAction="#showOverview"/>
            <Button text="🚨  Emergency Request" styleClass="sidebar-nav-btn" maxWidth="Infinity" onAction="#showEmergency"/>
            <Button text="📋  Request History"   styleClass="sidebar-nav-btn" maxWidth="Infinity" onAction="#showHistory"/>

            <Region VBox.vgrow="ALWAYS"/>
            <Label text="ACCOUNT" styleClass="sidebar-section-label"/>
            <Button text="🚪  Logout" styleClass="sidebar-nav-btn" maxWidth="Infinity" onAction="#handleLogout"/>
            <VBox style="-fx-padding: 8;"/>
        </VBox>
    </left>

    <!-- ── Topbar ── -->
    <top>
        <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="12">
            <Label fx:id="topbarTitle" text="Hospital Dashboard" styleClass="topbar-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox alignment="CENTER_RIGHT" spacing="2">
                <Label fx:id="topbarUserName" text="Hospital" styleClass="topbar-user-name"/>
                <Label text="HOSPITAL" styleClass="topbar-user-role"/>
            </VBox>
            <Button text="Logout" styleClass="topbar-logout-btn" onAction="#handleLogout"/>
        </HBox>
    </top>

    <!-- ── Content ── -->
    <center>
        <StackPane fx:id="contentStack" styleClass="content-area">

            <!-- ── OVERVIEW ── -->
            <VBox fx:id="overviewPanel" spacing="20" visible="true">
                <Label text="Hospital Blood Management" style="-fx-font-size:22; -fx-font-weight:bold; -fx-text-fill:#f0f4ff;"/>

                <!-- Stat cards -->
                <HBox spacing="16">
                    <VBox styleClass="stat-card,stat-card-accent" spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="📋" styleClass="stat-card-icon"/>
                        <Label fx:id="statTotal"     text="0" styleClass="stat-card-value"/>
                        <Label text="Total Requests" styleClass="stat-card-label"/>
                    </VBox>
                    <VBox styleClass="stat-card,stat-card-warning" spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="⏳" styleClass="stat-card-icon"/>
                        <Label fx:id="statPending"   text="0" styleClass="stat-card-value"/>
                        <Label text="Pending"         styleClass="stat-card-label"/>
                    </VBox>
                    <VBox styleClass="stat-card" spacing="8" HBox.hgrow="ALWAYS"
                          style="-fx-border-color: transparent transparent transparent rgba(229,62,62,1); -fx-border-width: 0 0 0 4;">
                        <Label text="🚨" styleClass="stat-card-icon"/>
                        <Label fx:id="statEmergency" text="0" styleClass="stat-card-value"/>
                        <Label text="Emergency"       styleClass="stat-card-label"/>
                    </VBox>
                    <VBox styleClass="stat-card,stat-card-success" spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="✅" styleClass="stat-card-icon"/>
                        <Label fx:id="statFulfilled" text="0" styleClass="stat-card-value"/>
                        <Label text="Fulfilled"       styleClass="stat-card-label"/>
                    </VBox>
                </HBox>

                <!-- Quick actions -->
                <VBox styleClass="stat-card" spacing="12">
                    <Label text="Quick Actions" styleClass="section-header"/>
                    <HBox spacing="12">
                        <Button text="🚨 Submit Emergency Request" styleClass="btn-primary"   onAction="#showEmergency"/>
                        <Button text="📋 View All Requests"        styleClass="btn-secondary" onAction="#showHistory"/>
                    </HBox>
                </VBox>

                <Label fx:id="overviewStatus" text="" wrapText="true" style="-fx-text-fill:#8892b0;"/>
            </VBox>

            <!-- ── EMERGENCY REQUEST FORM ── -->
            <VBox fx:id="emergencyPanel" spacing="20" visible="false">
                <Label text="Submit Blood Request" style="-fx-font-size:22; -fx-font-weight:bold; -fx-text-fill:#f0f4ff;"/>

                <VBox styleClass="stat-card" spacing="16" maxWidth="600">
                    <Label text="Request Details" styleClass="section-header"/>

                    <HBox spacing="16">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Blood Group Needed *" styleClass="form-label"/>
                            <ComboBox fx:id="emerGroup" promptText="Blood group" maxWidth="Infinity" styleClass="combo-box">
                                <items>
                                    <FXCollections fx:factory="observableArrayList">
                                        <String fx:value="A_POSITIVE"/>
                                        <String fx:value="A_NEGATIVE"/>
                                        <String fx:value="B_POSITIVE"/>
                                        <String fx:value="B_NEGATIVE"/>
                                        <String fx:value="AB_POSITIVE"/>
                                        <String fx:value="AB_NEGATIVE"/>
                                        <String fx:value="O_POSITIVE"/>
                                        <String fx:value="O_NEGATIVE"/>
                                    </FXCollections>
                                </items>
                            </ComboBox>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Quantity (units) *" styleClass="form-label"/>
                            <TextField fx:id="emerQuantity" styleClass="form-field" promptText="e.g. 4" text="1"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="6">
                        <Label text="Priority *" styleClass="form-label"/>
                        <ComboBox fx:id="emerPriority" promptText="Priority" maxWidth="Infinity" styleClass="combo-box">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="NORMAL"/>
                                    <String fx:value="URGENT"/>
                                    <String fx:value="EMERGENCY"/>
                                </FXCollections>
                            </items>
                        </ComboBox>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Patient Details / Ward / Notes" styleClass="form-label"/>
                        <TextArea fx:id="emerNotes" styleClass="form-field" prefHeight="90"
                                  promptText="Patient ward, special blood type notes, urgency reason..." wrapText="true"/>
                    </VBox>

                    <Label fx:id="emerStatus" text="" wrapText="true"/>

                    <HBox spacing="12">
                        <Button text="🚨 Submit Request" styleClass="btn-primary"   onAction="#handleSubmitEmergency"/>
                        <Button text="Cancel"             styleClass="btn-secondary" onAction="#showOverview"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- ── HISTORY TABLE ── -->
            <VBox fx:id="historyPanel" spacing="16" visible="false">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Blood Request History" style="-fx-font-size:22; -fx-font-weight:bold; -fx-text-fill:#f0f4ff;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="🚨 New Request" styleClass="btn-primary"   onAction="#showEmergency"/>
                    <Button text="Refresh"         styleClass="btn-secondary" onAction="#showHistory"/>
                </HBox>

                <TableView fx:id="histTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                    <columns>
                        <TableColumn fx:id="colHId"       text="#"          prefWidth="60"/>
                        <TableColumn fx:id="colHGroup"    text="Blood Type" prefWidth="110"/>
                        <TableColumn fx:id="colHQty"      text="Units"      prefWidth="80"/>
                        <TableColumn fx:id="colHPriority" text="Priority"   prefWidth="110"/>
                        <TableColumn fx:id="colHStatus"   text="Status"     prefWidth="160"/>
                        <TableColumn fx:id="colHNotes"    text="Notes"      prefWidth="200"/>
                        <TableColumn fx:id="colHDate"     text="Date"       prefWidth="130"/>
                    </columns>
                    <placeholder>
                        <Label text="No requests submitted yet." style="-fx-text-fill:#4a5568;"/>
                    </placeholder>
                </TableView>
            </VBox>

        </StackPane>
    </center>
</BorderPane>
