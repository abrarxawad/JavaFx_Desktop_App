<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.lifelink.controller.LoginController"
           styleClass="login-root">

    <!-- ── Full-screen background gradient ── -->
    <VBox alignment="CENTER" styleClass="login-bg">

        <!-- ── Login Card ── -->
        <VBox fx:id="loginCard" styleClass="login-card" maxWidth="420" spacing="0">

            <!-- Logo / Branding Header -->
            <VBox styleClass="login-header" alignment="CENTER" spacing="8">
                <Label text="🩸" styleClass="login-logo-icon"/>
                <Label text="LifeLink" styleClass="login-app-name"/>
                <Label text="Blood Bank &amp; Donor Navigation System"
                       styleClass="login-subtitle" wrapText="true"/>
            </VBox>

            <!-- Form Body -->
            <VBox styleClass="login-form-body" spacing="16">

                <!-- Error Banner (hidden by default) -->
                <Label fx:id="errorLabel"
                       styleClass="login-error-label"
                       wrapText="true"
                       visible="false"
                       managed="false"/>

                <!-- Username Field -->
                <VBox spacing="6">
                    <Label text="Username" styleClass="login-field-label"/>
                    <TextField fx:id="usernameField"
                               promptText="Enter your username"
                               styleClass="login-text-field"/>
                </VBox>

                <!-- Password Field -->
                <VBox spacing="6">
                    <Label text="Password" styleClass="login-field-label"/>
                    <PasswordField fx:id="passwordField"
                                  promptText="Enter your password"
                                  styleClass="login-text-field"/>
                </VBox>

                <!-- Login Button -->
                <Button fx:id="loginButton"
                        text="Sign In"
                        styleClass="login-btn-primary"
                        maxWidth="Infinity"
                        onAction="#handleLogin"/>

                <!-- Divider -->
                <HBox alignment="CENTER" spacing="10">
                    <Separator HBox.hgrow="ALWAYS"/>
                    <Label text="or" styleClass="login-divider-text"/>
                    <Separator HBox.hgrow="ALWAYS"/>
                </HBox>

                <!-- Register Link -->
                <HBox alignment="CENTER" spacing="6">
                    <Label text="Don't have an account?" styleClass="login-link-text"/>
                    <Button fx:id="registerButton"
                            text="Create Account"
                            styleClass="login-btn-link"
                            onAction="#handleRegister"/>
                </HBox>

            </VBox>

            <!-- Footer -->
            <HBox styleClass="login-footer" alignment="CENTER">
                <Label text="LifeLink v1.0  ·  Secure Login" styleClass="login-footer-text"/>
            </HBox>

        </VBox>

    </VBox>

</StackPane>
